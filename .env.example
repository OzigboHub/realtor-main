# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random hex string: openssl rand -hex 64
JWT_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=1234

# ─── Super Admin Seed ─────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=

# ─── Mail Provider ───────────────────────────────────────────────────────────
# Set to "resend" or "smtp". Omit to log emails to console (dev mode).
MAIL_PROVIDER=resend
MAIL_FROM=Realtor Platform <no-reply@yourdomain.com>

# ─── Frontend & CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Comma-separated for multiple origins
CORS_ORIGIN=http://localhost:3000

# ─── Resend (MAIL_PROVIDER=resend) ───────────────────────────────────────────
RESEND_API_KEY=

# ─── SMTP / Nodemailer (MAIL_PROVIDER=smtp) ──────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1234/api/v1/auth/google/callback

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# https://aistudio.google.com
GEMINI_API_KEY=

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Use sk_live_* / pk_live_* in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
